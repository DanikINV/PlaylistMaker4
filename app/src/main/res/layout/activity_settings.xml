<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white_primary">

    <LinearLayout
        android:id="@+id/toolbar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/spacing_medium">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/back"
            android:focusable="true"
            android:src="@drawable/ic_back_arrow_24"
            tools:ignore="TouchTargetSizeCheck" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            style="@style/TextAppearance.PlaylistMaker.Title" />

    </LinearLayout>

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switch_dark_theme"
        android:layout_width="match_parent"
        android:layout_height="61dp"
        android:paddingHorizontal="@dimen/spacing_medium"
        android:fontFamily="@font/ys_display_regular"
        android:textSize="@dimen/text_size_body"
        android:textColor="@color/black"
        android:text="@string/dark_theme" />

    <TextView
        android:id="@+id/btn_share"
        style="@style/Widget.PlaylistMaker.SettingsItem"
        android:text="@string/share_app"
        app:drawableEndCompat="@drawable/ic_share"
        app:drawableTint="@color/settings_icon_color" />

    <TextView
        android:id="@+id/btn_support"
        style="@style/Widget.PlaylistMaker.SettingsItem"
        android:text="@string/support"
        app:drawableEndCompat="@drawable/ic_support"
        app:drawableTint="@color/settings_icon_color" />

    <TextView
        android:id="@+id/btn_user_agreement"
        style="@style/Widget.PlaylistMaker.SettingsItem"
        android:text="@string/user_agreement"
        app:drawableEndCompat="@drawable/ic_arrow_forward"
        app:drawableTint="@color/settings_icon_color" />

</LinearLayout>
