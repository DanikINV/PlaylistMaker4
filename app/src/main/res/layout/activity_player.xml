<?xml version="1.0" encoding="utf-8"?>

<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white_primary">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/root_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white_primary"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/spacing_medium"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_back_arrow_24"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                tools:ignore="TouchTargetSizeCheck" />

            <ImageView
                android:id="@+id/iv_artwork"
                android:layout_width="312dp"
                android:layout_height="312dp"
                android:layout_marginHorizontal="@dimen/spacing_medium"
                android:layout_marginTop="32dp"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/vector"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintTop_toBottomOf="@id/btn_back"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tv_track_name"
                android:layout_width="312dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_medium"
                android:layout_marginTop="24dp"
                android:textColor="@color/black"
                android:textSize="19sp"
                android:fontFamily="@font/ys_display_medium"
                android:maxLines="2"
                android:ellipsize="end"
                app:layout_constraintTop_toBottomOf="@id/iv_artwork"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="Yesterday (Remastered 2009)" />

            <TextView
                android:id="@+id/tv_artist_name"
                android:layout_width="312dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_medium"
                android:layout_marginTop="4dp"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:fontFamily="@font/ys_display_regular"
                android:maxLines="1"
                android:ellipsize="end"
                app:layout_constraintTop_toBottomOf="@id/tv_track_name"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="The Beatles" />

            <ImageView
                android:id="@+id/btn_add_to_playlist"
                android:layout_width="51dp"
                android:layout_height="51dp"
                android:layout_marginStart="24dp"
                android:background="@drawable/bg_circle_button_neutral"
                android:contentDescription="@null"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_playlist_add"
                app:tint="@color/player_layout_icon"
                app:layout_constraintBottom_toBottomOf="@id/btn_play"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/btn_play" />

            <ImageView
                android:id="@+id/btn_play"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_marginTop="32dp"
                android:src="@drawable/ic_play_button"
                android:scaleType="centerInside"
                android:contentDescription="@null"
                app:layout_constraintTop_toBottomOf="@id/tv_artist_name"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <ImageView
                android:id="@+id/btn_favorite"
                android:layout_width="51dp"
                android:layout_height="51dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/bg_circle_button_neutral"
                android:contentDescription="@null"
                android:padding="10dp"
                android:src="@drawable/ic_favorite_border"
                app:layout_constraintBottom_toBottomOf="@id/btn_play"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/btn_play" />
            <TextView
                android:id="@+id/tv_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/default_progress"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:fontFamily="@font/ys_display_regular"
                app:layout_constraintTop_toBottomOf="@id/btn_play"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                android:id="@+id/row_duration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_medium"
                android:layout_marginTop="32dp"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/tv_progress"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/duration"
                    android:textColor="@color/track_secondary_text"
                    android:textSize="13sp"
                    android:fontFamily="@font/ys_display_regular" />

                <TextView
                    android:id="@+id/tv_duration_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="13sp"
                    android:fontFamily="@font/ys_display_regular"
                    tools:text="5:35" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_album"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_medium"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/row_duration"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/album"
                    android:textColor="@color/track_secondary_text"
                    android:textSize="13sp"
                    android:fontFamily="@font/ys_display_regular" />

                <TextView
                    android:id="@+id/tv_album_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="13sp"
                    android:fontFamily="@font/ys_display_regular"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Yesterday (Remastered 2009)" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_year"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_medium"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/row_album"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/year"
                    android:textColor="@color/track_secondary_text"
                    android:textSize="13sp"
                    android:fontFamily="@font/ys_display_regular" />

                <TextView
                    android:id="@+id/tv_year_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="13sp"
                    android:fontFamily="@font/ys_display_regular"
                    tools:text="1965" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_genre"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_medium"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/row_year"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/genre"
                    android:textColor="@color/track_secondary_text"
                    android:textSize="13sp"
                    android:fontFamily="@font/ys_display_regular" />

                <TextView
                    android:id="@+id/tv_genre_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="13sp"
                    android:fontFamily="@font/ys_display_regular"
                    tools:text="Rock" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_country"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_medium"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/row_genre"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/country"
                    android:textColor="@color/track_secondary_text"
                    android:textSize="13sp"
                    android:fontFamily="@font/ys_display_regular" />

                <TextView
                    android:id="@+id/tv_country_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="13sp"
                    android:fontFamily="@font/ys_display_regular"
                    tools:text="Великобритания" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>


    <View
        android:id="@+id/playlist_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone" />


    <LinearLayout
        android:id="@+id/playlist_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_bottom_sheet"
        android:elevation="8dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        app:behavior_hideable="true"
        app:behavior_peekHeight="0dp"
        app:behavior_skipCollapsed="true"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:text="@string/add_playlist"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:fontFamily="@font/ys_display_medium" />


        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_new_playlist"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:minWidth="180dp"
            android:paddingHorizontal="24dp"
            android:text="@string/new_playlist"
            android:textAllCaps="false"
            android:textSize="@dimen/text_size_body"
            android:textColor="@color/white"
            android:fontFamily="@font/ys_display_medium"
            android:background="@drawable/bg_button_retry"
            android:stateListAnimator="@null" />


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_playlist_sheet"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="16dp"
            android:clipToPadding="false"
            tools:listitem="@layout/item_playlist_sheet" />


    </LinearLayout>


    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/player_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="30dp"
        android:visibility="gone" />


    <TextView
        android:id="@+id/playlist_created_notification"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_gravity="bottom"
        android:background="@color/notification"
        android:elevation="50dp"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:textColor="@color/notification_text"
        android:textSize="16sp"
        android:fontFamily="@font/ys_display_regular"
        android:visibility="gone" />


</androidx.coordinatorlayout.widget.CoordinatorLayout>