<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_new_playlist"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:minWidth="180dp"
            android:paddingHorizontal="24dp"
            android:text="@string/new_playlist"
            android:textAllCaps="false"
            android:textSize="@dimen/text_size_body"
            android:textColor="@color/white"
            android:fontFamily="@font/ys_display_medium"
            android:background="@drawable/bg_button_retry"
            android:stateListAnimator="@null" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_playlists"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            android:visibility="gone" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/placeholder_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_placeholder_no_results" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/no_playlists"
            style="@style/TextAppearance.PlaylistMaker.EmptyState" />

    </LinearLayout>

    <TextView
        android:id="@+id/playlist_created_notification"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_gravity="bottom"
        android:background="@color/notification"
        android:elevation="50dp"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:textColor="@color/notification_text"
        android:textSize="16sp"
        android:fontFamily="@font/ys_display_regular"
        android:visibility="gone" />

</FrameLayout>