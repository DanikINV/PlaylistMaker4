<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TextAppearance.PlaylistMaker.Title" parent="android:TextAppearance">
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:layout_marginStart">16dp</item>
    </style>

    <style name="Widget.PlaylistMaker.Button.Main" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/blackButton</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:backgroundTint">@color/button_background</item>
        <item name="android:gravity">center</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.PlaylistMaker.SettingsItem" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">61dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">@dimen/spacing_medium</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="drawableTint">@color/settings_icon_color</item>
    </style>

    <style name="Widget.PlaylistMaker.BottomNavigationView.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

    <style name="PlaylistMakerDialogTheme"
        parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:textColorPrimary">@android:color/black</item>
        <item name="android:textColorSecondary">@android:color/black</item>
        <item name="android:colorAccent">@color/dialog_button_blue</item>
        <item name="colorPrimary">@color/dialog_button_blue</item>
        <item name="colorPrimaryVariant">@color/dialog_button_blue</item>
        <item name="colorAccent">@color/dialog_button_blue</item>
        <item name="buttonBarPositiveButtonStyle">@style/PlaylistMakerDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/PlaylistMakerDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/PlaylistMakerDialogButton</item>
    </style>

    <style name="DeleteTrackDialogTheme"
        parent="PlaylistMakerDialogTheme" />

    <style name="PlaylistMakerDialogButton"
        parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/dialog_button_blue</item>
        <item name="android:textAllCaps">false</item>
    </style>

</resources>